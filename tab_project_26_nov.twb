      <aliases enabled='yes' />
      <column caption='DemandFluctuation' datatype='integer' name='[Calculation_757167706265550848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[ridershipFY23 (Ridership_T1)] - [ridershipFY21 (Ridership_T1)]' />
      </column>
      <column caption='ActualFY23Ridership' datatype='integer' name='[Calculation_757167706270724097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ridershipFY23 (Ridership_T1)])' />
      </column>
      <column caption='PerformanceStatus' datatype='string' name='[Calculation_757167706270892034]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([ridershipFY23]) &lt; SUM([GoalsYoYRidership]) THEN &quot;Not Meeting&quot;&#13;&#10;ELSEIF SUM([ridershipFY23]) = SUM([GoalsYoYRidership]) THEN &quot;Meeting&quot;&#13;&#10;ELSE &quot;Exceeding&quot;&#13;&#10;END' />
      </column>
      <column caption='otp_improved' datatype='real' name='[Calculation_757167706272501763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[otpFY23otp] - [otpFY21otp]' />
      </column>
      <column caption='procurement_increase' datatype='integer' name='[Calculation_757167706272583684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[procurementFY23] - [procurementFY21]' />
      </column>
      <column caption='EmployeeChange' datatype='integer' name='[Calculation_757167706274430981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([employmentFY23]) - SUM([employmentFY21])' />
      </column>
      <column caption='RidershipChange' datatype='integer' name='[Calculation_757167706274508806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ridershipFY23 (Ridership_T1)]) - SUM([ridershipFY21 (Ridership_T1)])' />
      </column>
      <column caption='Correlation' datatype='string' name='[Calculation_757167706275246088]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM([employmentFY23]) - SUM([employmentFY21])) &gt; 0 AND (SUM([ridershipFY23]) - SUM([ridershipFY21])) &gt; 0 THEN &quot;Positive Correlation&quot;&#13;&#10;ELSEIF (SUM([employmentFY23]) - SUM([employmentFY21])) &lt; 0 AND (SUM([ridershipFY23]) - SUM([ridershipFY21])) &lt; 0 THEN &quot;Positive Correlation&quot;&#13;&#10;ELSEIF (SUM([employmentFY23]) - SUM([employmentFY21])) * (SUM([ridershipFY23]) - SUM([ridershipFY21])) &lt; 0 THEN &quot;Negative Correlation&quot;&#13;&#10;ELSE &quot;No Significant Change&quot;&#13;&#10;END' />
      </column>
