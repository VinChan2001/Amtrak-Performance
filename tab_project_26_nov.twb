    <worksheet name='Sheet 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>Comparison of FY23 Ridership Performance Against Goals: Meeting, Not Meeting, and Exceeding Targets</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='State_T+ (BUDT703_Project_0507_14)' name='federated.030e55i1xfnc8b12vimnc12augdq' />
          </datasources>
          <datasource-dependencies datasource='federated.030e55i1xfnc8b12vimnc12augdq'>
            <column caption='ActualFY23Ridership' datatype='integer' name='[Calculation_757167706270724097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ridershipFY23 (Ridership_T1)])' />
            </column>
            <column caption='PerformanceStatus' datatype='string' name='[Calculation_757167706270892034]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([ridershipFY23]) &lt; SUM([GoalsYoYRidership]) THEN &quot;Not Meeting&quot;&#13;&#10;ELSEIF SUM([ridershipFY23]) = SUM([GoalsYoYRidership]) THEN &quot;Meeting&quot;&#13;&#10;ELSE &quot;Exceeding&quot;&#13;&#10;END' />
            </column>
            <column caption='Goals Yo Y Ridership' datatype='real' name='[GoalsYoYRidership]' role='measure' type='quantitative' />
            <column-instance column='[GoalsYoYRidership]' derivation='Attribute' name='[attr:GoalsYoYRidership:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ridershipStateID (Ridership_T1)]' derivation='None' name='[none:ridershipStateID (Ridership_T1):nk]' pivot='key' type='nominal' />
            <column-instance column='[stateName]' derivation='None' name='[none:stateName:nk]' pivot='key' type='nominal' />
            <column caption='ridershipFY23 (Ridership T1)' datatype='integer' name='[ridershipFY23 (Ridership_T1)]' role='dimension' type='quantitative' />
            <column datatype='integer' name='[ridershipFY23]' role='dimension' type='quantitative' />
            <column caption='state ID' datatype='string' name='[ridershipStateID (Ridership_T1)]' role='dimension' type='nominal' />
            <column caption='State Name' datatype='string' name='[stateName]' role='dimension' type='nominal' />
            <column-instance column='[GoalsYoYRidership]' derivation='Sum' name='[sum:GoalsYoYRidership:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_757167706270724097]' derivation='User' name='[usr:Calculation_757167706270724097:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_757167706270892034]' derivation='User' name='[usr:Calculation_757167706270892034:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.030e55i1xfnc8b12vimnc12augdq].[usr:Calculation_757167706270724097:qk]' included-values='non-null' />
          <slices>
            <column>[federated.030e55i1xfnc8b12vimnc12augdq].[usr:Calculation_757167706270724097:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
