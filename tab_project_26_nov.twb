    <worksheet name='Sheet 5'>
      <layout-options>
        <title>
          <formatted-text>
            <run>States with the Highest Employee-to-Ridership Impact</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='State_T+ (BUDT703_Project_0507_14)' name='federated.030e55i1xfnc8b12vimnc12augdq' />
          </datasources>
          <datasource-dependencies datasource='federated.030e55i1xfnc8b12vimnc12augdq'>
            <column caption='EmployeeChange' datatype='integer' name='[Calculation_757167706274430981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([employmentFY23]) - SUM([employmentFY21])' />
            </column>
            <column caption='RidershipChange' datatype='integer' name='[Calculation_757167706274508806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ridershipFY23 (Ridership_T1)]) - SUM([ridershipFY21 (Ridership_T1)])' />
            </column>
            <column caption='Correlation' datatype='string' name='[Calculation_757167706275246088]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM([employmentFY23]) - SUM([employmentFY21])) &gt; 0 AND (SUM([ridershipFY23]) - SUM([ridershipFY21])) &gt; 0 THEN &quot;Positive Correlation&quot;&#13;&#10;ELSEIF (SUM([employmentFY23]) - SUM([employmentFY21])) &lt; 0 AND (SUM([ridershipFY23]) - SUM([ridershipFY21])) &lt; 0 THEN &quot;Positive Correlation&quot;&#13;&#10;ELSEIF (SUM([employmentFY23]) - SUM([employmentFY21])) * (SUM([ridershipFY23]) - SUM([ridershipFY21])) &lt; 0 THEN &quot;Negative Correlation&quot;&#13;&#10;ELSE &quot;No Significant Change&quot;&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[employmentFY21]' role='dimension' type='quantitative' />
            <column datatype='integer' name='[employmentFY23]' role='dimension' type='quantitative' />
            <column-instance column='[ridershipStateID (Ridership_T1)]' derivation='None' name='[none:ridershipStateID (Ridership_T1):nk]' pivot='key' type='nominal' />
            <column-instance column='[stateName]' derivation='None' name='[none:stateName:nk]' pivot='key' type='nominal' />
            <column caption='ridershipFY21 (Ridership T1)' datatype='integer' name='[ridershipFY21 (Ridership_T1)]' role='dimension' type='quantitative' />
            <column datatype='integer' name='[ridershipFY21]' role='dimension' type='quantitative' />
            <column caption='ridershipFY23 (Ridership T1)' datatype='integer' name='[ridershipFY23 (Ridership_T1)]' role='dimension' type='quantitative' />
            <column datatype='integer' name='[ridershipFY23]' role='dimension' type='quantitative' />
            <column caption='state ID' datatype='string' name='[ridershipStateID (Ridership_T1)]' role='dimension' type='nominal' />
            <column caption='State Name' datatype='string' name='[stateName]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_757167706274430981]' derivation='User' name='[usr:Calculation_757167706274430981:qk]' pivot='key' type='quantitative' />
